# ===========================================
# FLASHCARDS - Environment Variables
# ===========================================
# Este archivo está pensado y ubicado para ser gestionado por el IDE, que inyecta las variables al sistema para ser
#  leídas por todas las herramientas.
# Copia este archivo a .env y completa los valores.

# ---- MCPs ----
RENDER_MCP_TOKEN_FLASHCARDS=

# ---- DEV environment ----
APP_PROFILE=dev
DB_NAME=
DB_URL=
DB_USER=
DB_PASSWORD=
METRICS_USERNAME=
METRICS_PASSWORD=

# ---- Maileroo ----
MAILEROO_API_KEY=
MAILEROO_WEBHOOK_SECRET=
NOTIFY_FROM_ADDRESS=

# ---- JWT (Authentication) ----
JWT_SECRET_KEY=

# ---- Admin User (Flyway Seed) ----
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PSW_HASH=
ADMIN_ZONE=

# ---- Test User (Flyway Seed) ----
TEST_USERNAME=
TEST_USER_EMAIL=
TEST_USER_PSW_HASH=
TEST_USER_ZONE=

# ---- App URLs ----
APP_URL=
API_URL=

# ---- IA API Key Encryption ----
API_KEY_ENCRYPTION_SECRET=
API_KEY_ENCRYPTION_SECRET_V2=
